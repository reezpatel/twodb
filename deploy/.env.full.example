# Copy to ./.env next to where you run `docker compose -f deploy/docker-compose.full.yaml up -d`
# (or pass --env-file). MANDATORY values first.

# --- MANDATORY ---------------------------------------------------------------
ROOT_DOMAIN=twodb.io                       # console.<ROOT_DOMAIN>, <slug>.<ROOT_DOMAIN> — wildcard DNS to the gateway
AUTH_SECRET=change-me-to-a-long-random-string          # >=16 chars, permanent (encrypts stored secrets)
TWODB_REGISTRATION_SECRET=change-me-to-another-long-random-string  # >=16 chars
POSTGRES_PASSWORD=change-me-url-safe
S3_ACCESS_KEY_ID=twodb
S3_SECRET_ACCESS_KEY=change-me-s3-secret

# --- optional ------------------------------------------------------------------
# PUBLIC_SCHEME=https
# GATEWAY_PORT=6400
# DATA_DIR=./data
# TWODB_VERSION=latest
# REGISTRY_OWNER=reezpatel
# POSTGRES_USER=twodb
# POSTGRES_DB=twodb
# S3_BUCKET=twodb
# S3_REGION=us-east-1
# TWODB_OPEN_SIGNUP=false
# CATCH_ALL_SERVICE=
# CATCH_ALL_HOST_REGEX=
# TWOMAIL_ALLOWED_HOSTS=
# WORKSPACE_API_KEY=
