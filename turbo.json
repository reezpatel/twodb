{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "100",
  "globalPassThroughEnv": [
    "TWODB_*",
    "DEV_HTTPS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "gen:docs": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "ENDPOINTS.md",
        "MESSAGES.md",
        "endpoint.json",
        "messages.json"
      ]
    }
  }
}
