{
  "name": "twodb",
  "private": true,
  "scripts": {
    "local": "pnpm --parallel --filter @twodb/app-twodb --filter @twodb/app-twodb-webapp --filter @twodb/app-tworoute dev",
    "local:blocks": "pnpm --filter @twodb/blocks storybook",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "gen:docs": "turbo gen:docs",
    "scaffold": "node tools/scaffold-app.mjs",
    "db:up": "docker compose -f deploy/docker-compose.db.yaml up -d",
    "db:down": "docker compose -f deploy/docker-compose.db.yaml down",
    "db:logs": "docker compose -f deploy/docker-compose.db.yaml logs -f",
    "db:ps": "docker compose -f deploy/docker-compose.db.yaml ps"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@11.11.0"
}
