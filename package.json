    "@types/react-dom": "^19.2.4",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.29.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pluggable": "^0.4.3",
    "react-router": "^7.18.2"
