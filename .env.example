# Copy to .env (gitignored) and adjust as needed.
# These match the defaults baked into docker-compose.db.yaml.

# --- Postgres ---
POSTGRES_DB=twodb
POSTGRES_USER=twodb
POSTGRES_PASSWORD=twodb
POSTGRES_PORT=5432
# Connection string consumed by @fastify/postgres (apps/api).
DATABASE_URL=postgres://twodb:twodb@localhost:5432/twodb

# --- Memgraph (Bolt) ---
MEMGRAPH_BOLT_PORT=7687
# Connection string consumed by the memgraph fastify plugin (apps/api).
# Uses the neo4j+s scheme (encrypted Bolt). For plain local dev, neo4j:// works
# too - memgraph doesn't enforce TLS by default.
MEMGRAPH_URL=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- S3-compatible object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=twodb
S3_ACCESS_KEY_ID=twodb
S3_SECRET_ACCESS_KEY=twodb-secret
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- API ---
PORT=3001
STATIC_DIR=../../../apps/web/dist

# --- Identity ---
# User identifier mode: email | phone | email+phone
TWODB_IDENTIFIER=email
# Email of the first superadmin (granted at register/boot when none exists)
TWODB_SUPERADMIN_EMAIL=
# Verified-only gate: unverified sessions are confined to verify/session routes
TWODB_REQUIRE_VERIFIED=false
# Absolute origin of this api (magic-link + SSO callback URLs)
TWODB_API_ORIGIN=http://localhost:3001

# --- Node agent (apps/node) ---
# Secret from the nodes UI (POST /api/v1/io.twodb.node/nodes). Required —
# without it the agent idles. Local dev: apps/node/.env. Containers: root .env
# + `docker compose -f docker-compose.node.yaml up -d` (fails fast when unset).
TWO_DB_NODE_SECRET=
# Controller URL + WS path (defaults match local dev). The agent connects
# outbound, so in containers use http://host.docker.internal:3001 when running
# standalone, or http://twodb-server:3001 next to docker-compose.all.yaml
# (see the networks notes in docker-compose.node.yaml).
TWO_DB_CONTROLLER_URL=http://localhost:3001
# TWO_DB_CONTROLLER_WS_PATH=/api/v1/io.twodb.node/nodes/ws
# Heartbeat interval in ms (default 10000)
TWO_DB_HEARTBEAT_MS=10000
# Local jail root for file/command APIs (default: agent's cwd; the container
# compose binds ./node-workspace to /workspace and defaults TWO_DB_ROOT_DIR
# to /workspace)
TWO_DB_ROOT_DIR=
# AES-256-GCM key material for encrypting agent credentials at rest
# (any string; hashed to 32 bytes). MUST be overridden outside dev.
TWODB_AGENT_ENCRYPTION_KEY=
# Cron tick for agent usage collection (default 300000 = 5min). Actual
# refetch per provider is governed by its own TTL (default 15min).
TWODB_AGENT_USAGE_INTERVAL_MS=300000

# --- Api-owned sqlite database (admin api) ---
# Directory holding db-v1.sqlite. Relative paths resolve from apps/api/src.
TWO_DB_WORK_DIR=../../../.work

# --- Admin HTTPS dev (WebAuthn over LAN) ---
# Serve vite over TLS so the origin is a secure context when browsing via
# LAN hostname/IP. A self-signed cert (SANs: localhost, hostname,
# hostname.local, all LAN IPv4s) is generated into .work/certs/ on first run.
TWODB_WEB_HTTPS=0
# rpID must be the HOSTNAME you browse with (IPs are rejected by browsers);
# origin must match exactly. Example for https://divine.local:5173:
# TWODB_ADMIN_RP_ID=divine.local
# TWODB_ADMIN_ORIGIN=https://divine.local:5173
