# Copy to .env (gitignored). Shared across the workspace — every app reads
# what it needs via its own Zod config schema (@twodb/core-data/config).

# --- Shared Postgres cluster (one schema per app, provisioned by TwoDB) ---
POSTGRES_DB=twodb
POSTGRES_USER=twodb
POSTGRES_PASSWORD=twodb
POSTGRES_PORT=5432
# Admin connection TwoDB uses ONLY to provision other apps' schemas/roles.
# No other app ever sees this — each gets its own role's connection string
# back from `GET /registry/config` (via twodb-core) — no DATABASE_URL in app env.
TWODB_PG_ADMIN_URL=postgres://twodb:twodb@localhost:5432/twodb

# --- Memgraph (Bolt) — opt-in, only apps using @twodb/core-graph need this ---
MEMGRAPH_URL=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- TwoDB (control plane + Gateway) ---
TWODB_PORT=6400
TWODB_SQLITE_FILE=./.data/twodb-control-plane.sqlite
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_BASE_URL=http://localhost:6400
AUTH_TRUSTED_ORIGINS=http://localhost:6500
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:6500
# Optional social/OIDC sign-in — omit to just use passkeys:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POCKETID_ISSUER=
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=

# --- Every other app dials the Gateway, never each other directly ---
TWODB_GATEWAY_URL=http://localhost:6400

# --- App registration ---
# Shared by every app you run yourself (pnpm dev). twodb-core presents it to
# POST /registry/register and gets back a 30-day app token (cached in
# .twodb/<slug>.token). Managed (docker) apps get a non-expiring
# TWODB_APP_TOKEN injected by TwoDB instead. Use a long random string.
TWODB_REGISTRATION_SECRET=change-me-to-another-long-random-string
# Heartbeat: apps ping every 10s; silence for this long marks them inactive.
# TWODB_HEARTBEAT_TIMEOUT_MS=30000
# Lifetime of tokens minted via the registration secret / admin API.
# TWODB_APP_TOKEN_TTL_DAYS=30
# Passkey sign-up: false = only the first user can register; true = open.
# TWODB_OPEN_SIGNUP=false

# --- Global S3-compatible storage (optional) — one bucket, per-app key prefix (<slug>/) ---
# TWODB_S3_BUCKET=twodb
# TWODB_S3_ENDPOINT=http://localhost:9000
# TWODB_S3_REGION=us-east-1
# TWODB_S3_ACCESS_KEY_ID=twodb
# TWODB_S3_SECRET_ACCESS_KEY=twodb-secret
# TWODB_S3_FORCE_PATH_STYLE=true

# --- App backends (dev) — fixed ports per the orchestrator catalog ---
TWOROUTE_PORT=6401

# --- App ports (host dev + docker — fixed per app, see orchestrator catalog) ---
# Everything lives in the 64XX/65XX band: gateway 6400, installable apps
# 6401+ sequentially, dev webapps 6500 (twodb) / 6501+ (scaffolded),
# storybooks 6520+. App backends read PORT; webapp ports are set by their
# own vite configs.
TWOMAIL_PORT=6402
TWODAY_PORT=6403
TWOCONTACTS_PORT=6404
TWOCHAT_PORT=6405
TWODRIVE_PORT=6406
ARTISAN_PORT=6407
DISPATCH_PORT=6408
TWORING_PORT=6409
GARDEN_PORT=6410
TWOTHING_PORT=6411
TWOLOOP_PORT=6412
MEMBRAIN_PORT=6413
PAINTRESS_PORT=6414
TWOPIN_PORT=6415
TWODOO_PORT=6416
