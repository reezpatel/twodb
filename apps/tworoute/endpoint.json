      "name": "openaiCompatChat",
      "method": "POST",
      "path": "/v1/chat/completions",
      "auth": "session-or-apiKey",
      "description": "OpenAI path-shape alias of POST /completions — same handler. Point any stock OpenAI SDK client (openai npm pkg, Cursor, Continue…) at {gateway}/apps/tworoute/v1 with a TwoDB workspace API key as the apiKey; the gateway accepts workspace keys in the Authorization: Bearer slot too. A model id of the form \"<connection-name>/<model-id>\" (as returned by GET /v1/models) targets that connection specifically; a bare model name uses the first visible connection (or explicit connectionId/connectionName).",
      "streaming": true,
      "request": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string"
          },
          "connectionName": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
