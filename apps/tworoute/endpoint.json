    {
      "name": "completions",
      "method": "POST",
      "path": "/completions",
      "auth": "session-or-apiKey",
      "description": "OpenAI-compatible chat completions (anthropic/responses wires translated per provider). Pick a connection via `connectionId`, `connectionName` (unique per workspace — handy for CLI/tests), or the first visible in-scope if both are omitted. Non-streaming requests get a plain JSON response and are usage-logged; `stream: true` is a raw pass-through. OAuth-backed providers (claude-code, codex) get their access token refreshed automatically when stale. Any external tool (e.g. Cursor) can point at this with a workspace API key, same as an internal app.",
      "streaming": true,
      "request": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string"
          },
          "connectionName": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "stream": {
            "type": "boolean"
          },
          "temperature": {
            "type": "number"
          },
          "max_tokens": {
            "type": "number"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "additionalProperties": false
      }
    },
