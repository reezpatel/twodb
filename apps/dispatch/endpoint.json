      "description": "Raw WS relay to a microvm's terminal (pty bytes in both directions) or its VSCode fork (code-server): ?mode=terminal|vscode. Runners host the relay over vsock; dispatch bridges it to callers through the Gateway's WS passthrough.",
      "streaming": true,
      "request": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "terminal",
              "vscode"
            ]
          }
        },
        "required": [
          "identifier",
          "mode"
        ],
        "additionalProperties": false
      },
      "response": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "string"
      }
    },
    {
      "name": "shutdownMicrovm",
      "method": "POST",
      "path": "/microvms/:identifier/shutdown",
      "auth": "session-or-apiKey",
      "description": "Shuts a microvm down gracefully: zips /app, uploads to S3 (stub), powers off. Same-identifier resume restores /app. Pass archive=1 to also sweep it for archive after inactivity.",
      "request": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "archive": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "identifier"
        ],
        "additionalProperties": false
      },
      "response": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "runnerId": {
            "type": "string"
          },
          "runnerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "idle-stopped",
              "archived",
              "failed"
            ]
          },
          "cid": {
            "type": [
              "number",
              "null"
            ]
          },
          "bootCount": {
            "type": "number"
          },
          "lastActiveAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "identifier",
          "runnerId",
          "runnerName",
          "status",
          "cid",
          "bootCount",
          "lastActiveAt",
          "createdAt",
          "archivedAt"
        ],
        "additionalProperties": false
      }
    }
  ]
