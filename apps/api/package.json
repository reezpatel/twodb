{
  "name": "twodb-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../../docker-compose.db.yml up -d",
    "db:down": "docker compose -f ../../docker-compose.db.yml down",
    "db:logs": "docker compose -f ../../docker-compose.db.yml logs -f"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/env": "^7.0.0",
    "@fastify/postgres": "^6.1.0",
    "@twodb/contracts": "workspace:*",
    "@twodb/plugin-notes": "workspace:*",
    "@twodb/shared-backend": "workspace:*",
    "fastify": "^5.3.0",
    "fastify-plugin": "^6.0.0",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
