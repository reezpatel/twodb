# Copy to .env (gitignored) and adjust as needed.
# These match the defaults baked into docker-compose.db.yaml.

# --- Postgres ---
POSTGRES_DB=twodb
POSTGRES_USER=twodb
POSTGRES_PASSWORD=twodb
POSTGRES_PORT=5432
# Connection string consumed by @fastify/postgres (apps/api).
TWODB_DATABASE_URL=postgres://twodb:twodb@localhost:5432/twodb

# --- Memgraph (Bolt) ---
MEMGRAPH_BOLT_PORT=7687
# Connection string consumed by the memgraph fastify plugin (apps/api).
# Uses the neo4j+s scheme (encrypted Bolt). For plain local dev, neo4j:// works
# too - memgraph doesn't enforce TLS by default.
MEMGRAPH_URL=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- S3-compatible object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=twodb
S3_ACCESS_KEY_ID=twodb
S3_SECRET_ACCESS_KEY=twodb-secret
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- API ---
TWODB_PORT=3001
STATIC_DIR=../../../apps/web/dist

# --- Identity ---
# User identifier mode: email | phone | email+phone
TWODB_IDENTIFIER=email
# Email of the first superadmin (granted at register/boot when none exists)
TWODB_SUPERADMIN_EMAIL=
# Verified-only gate: unverified sessions are confined to verify/session routes
TWODB_REQUIRE_VERIFIED=false
# Absolute origin of this api (magic-link + SSO callback URLs)
TWODB_API_ORIGIN=http://localhost:3001

# --- Runner (apps/runner) ---
# Access key from Settings → Runners. Required — the runner exits without it.
# Local dev: apps/runner/.env or shell env. Containers: root .env +
# `docker compose -f docker-compose.runner.yaml up -d` (fails fast when unset).
TWODB_RUNNER_KEY=
# Server the runner connects to (outbound WS). In containers use
# http://host.docker.internal:3001 when running standalone, or
# http://twodb-server:3001 next to docker-compose.all.yaml.
TWODB_SERVER_URL=http://localhost:3001
# Display name shown in Settings → Runners (defaults to hostname)
TWODB_RUNNER_NAME=

# Directory with the built desktop app (static SPA). When set, the server
# serves it at / and keeps /api for the API. The Docker image sets this
# itself; only set it for bare-metal deploys.
#TWODB_STATIC_DIR=

# --- Admin HTTPS dev (WebAuthn over LAN) ---
# Serve vite over TLS so the origin is a secure context when browsing via
# LAN hostname/IP. A self-signed cert (SANs: localhost, hostname,
# hostname.local, all LAN IPv4s) is generated into .work/certs/ on first run.
TWODB_WEB_HTTPS=0
# rpID must be the HOSTNAME you browse with (IPs are rejected by browsers);
# origin must match exactly. Example for https://divine.local:5173:
# TWODB_ADMIN_RP_ID=divine.local
# TWODB_ADMIN_ORIGIN=https://divine.local:5173
