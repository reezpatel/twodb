{
  "manifest_version": 3,
  "name": "twodb Meeting Recorder",
  "version": "0.2.1",
  "description": "Record Google Meet, Teams and Zoom meetings — tab, your microphone and an optional screen — into twodb.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "desktopCapture",
    "offscreen",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "commands": {
    "record-toggle": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Start or stop recording the current tab"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "twodb Meeting Recorder"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://app.zoom.us/wc/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
